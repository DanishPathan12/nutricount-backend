# ==========================================
# Nutricount Backend - Environment Template
# ==========================================

# Application Port & Environment
PORT=5000
NODE_ENV=production

# Database Configuration (AWS RDS PostgreSQL)
DB_HOST=your-rds-instance.xxxxxx.us-east-1.rds.amazonaws.com
DB_PORT=5432
DB_NAME=nutricount
DB_USER=postgres
DB_PASSWORD=your_strong_rds_password

# Authentication Secrets (minimum 32 characters each)
JWT_ACCESS_SECRET=replace_with_a_secure_random_string_min_32_chars
JWT_REFRESH_SECRET=replace_with_another_secure_random_string_min_32_chars

# Google OAuth
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Frontend URL(s) for CORS (comma-separated if multiple)
FRONTEND_URL=https://app.nutricount.com,http://localhost:3000

# Email SMTP Settings (Optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Nutricount <no-reply@nutricount.com>

